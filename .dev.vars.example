# wrangler dev 用の Secrets 雛形（SPEC §3.2）。
# このファイルをコピーして `.dev.vars` を作り、実値を入れる。`.dev.vars` は .gitignore 済み。
# 本番は `wrangler secret put <NAME>` で登録する。実値をこのファイルに書かない。

# 32バイトを base64 にしたもの。トークン・AIキーの暗号化鍵（AES-256-GCM）。
#   生成: openssl rand -base64 32
ENC_KEY=

# 32バイト以上。セッション署名と署名トークン（pwreset / qaction）の HMAC 鍵。
#   生成: openssl rand -base64 48
SESSION_SECRET=

# 管理API（ライセンス発行・失効）の鍵。X-Admin-Secret ヘッダで送る。
#   生成: openssl rand -hex 32
ADMIN_SECRET=

# メール送信（Resend）。未設定ならメールは送らず、開発用のコンソール出力にフォールバックする。
RESEND_API_KEY=

# 差出人アドレス（未設定なら noreply@example.com）
MAIL_FROM=

# Web Push の鍵ペア（SPEC §7.8 / §12.4）。
# 未設定なら設定画面のプッシュのスイッチが無効になり、購読の登録もできない（メールだけになる）。
# 生成（どちらか）:
#   npx web-push generate-vapid-keys
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem \
#     && openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 | tr '+/' '-_' | tr -d '=\n'   # 公開鍵
#     && openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 | base64 | tr '+/' '-_' | tr -d '=\n' # 秘密鍵
# 公開鍵はブラウザに渡すので秘密ではない。秘密鍵は wrangler secret put で入れる。
# 実際の送信は M7（DECISIONS.md 2026-09-06）。M6 は購読の登録・解除までを作る。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 開発時のモック（SPEC §11）。1 で有効、DEV ビルドのときだけ効く（本番バンドルには入らない）
#   THREADS_MOCK=1 … Threads API のモック（トークンが THAAdemo で始まるときだけ）
#   AI_MOCK=1      … AI 呼び出しのモック（固定 JSON を返す。M5 の画面確認用）
THREADS_MOCK=1
AI_MOCK=1
