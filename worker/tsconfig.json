{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tap/shared": ["../shared/src/index.ts"],
      "@tap/shared/*": ["../shared/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "vitest.config.ts"]
}
